<?php

/**
 * @file
 * jsso-theme theme file.
 */
/**
 * Implements hook_leaflet_views_feature_alter().
 */
function jssotheme_leaflet_views_feature_alter(array &$feature, \Drupal\views\ResultRow $row, \Drupal\leaflet_views\Plugin\views\style\LeafletMap $style) {
  // Check if this is targeting a project map.
  if (isset($style->view) && $style->view->id() == 'project_map') {
    $node = $row->_entity;
    if ($node && $node->hasField('field_status') && !$node->get('field_status')->isEmpty()) {
      $status_id = $node->get('field_status')->target_id;
      // 33: Ongoing / Active -> Green
      // 32: Pipeline / Identification -> Yellow
      switch ($status_id) {
        case 33:
          $feature['icon'] = [
            'iconUrl' => 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png',
            'shadowUrl' => 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            'iconSize' => [25, 41],
            'iconAnchor' => [12, 41],
            'popupAnchor' => [1, -34],
            'shadowSize' => [41, 41],
          ];
          break;

        case 32:
          $feature['icon'] = [
            'iconUrl' => 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-yellow.png',
            'shadowUrl' => 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            'iconSize' => [25, 41],
            'iconAnchor' => [12, 41],
            'popupAnchor' => [1, -34],
            'shadowSize' => [41, 41],
          ];
          break;
      }
    }
  }
}

/**
 * Implements hook_leaflet_map_view_style_alter().
 */
function jssotheme_leaflet_map_view_style_alter(array &$map, \Drupal\leaflet_views\Plugin\views\style\LeafletMap $style) {
  if (isset($style->view) && $style->view->id() == 'project_map') {
    // Restrict bounds to Africa as per user request.
    // South-West [-40, -25], North-East [40, 60]
    $map['settings']['maxBounds'] = [
      [-40, -25],
      [40, 60],
    ];
  }
}


/**
 * Implements hook_theme_suggestions_page_alter().
 */
function jssotheme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Check if we are viewing a node.
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    // If the node is an object (standard view), add the suggestion.
    if (is_object($node)) {
      $suggestions[] = 'page__' . $node->bundle();
    }
  }
}
/**
 * Implements hook_theme_suggestions_block_alter().
 */
function jssotheme_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (isset($variables['elements']['content']['#block_content'])) {
    $bundle = $variables['elements']['content']['#block_content']->bundle();
    $suggestions[] = 'block__block_content__' . $bundle;
  }
}

/**
 * Implements hook_form_views_exposed_form_alter().
 */
function jssotheme_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if ($view->id() == 'jsso_knowledge_hub') {
    $query = \Drupal::request()->query->all();

    // Custom Focus Area filter
    $focus_nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'focus', 'status' => 1]);
    $focus_options = [];
    foreach ($focus_nodes as $node) {
      $focus_options[$node->id()] = $node->getTitle();
    }
    $form['custom_focus_area'] = [
      '#type' => 'checkboxes',
      '#options' => $focus_options,
      '#title' => t('Focus Areas'),
      '#default_value' => isset($query['custom_focus_area']) ? $query['custom_focus_area'] : [],
      '#weight' => -10,
    ];

    // Custom Initiatives filter
    $initiative_nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'initiative', 'status' => 1]);
    $initiative_options = [];
    foreach ($initiative_nodes as $node) {
      $initiative_options[$node->id()] = $node->getTitle();
    }
    $form['custom_initiatives'] = [
      '#type' => 'checkboxes',
      '#options' => $initiative_options,
      '#title' => t('Initiatives'),
      '#default_value' => isset($query['custom_initiatives']) ? $query['custom_initiatives'] : [],
      '#weight' => -9,
    ];
  }
}

/**
 * Implements hook_views_query_alter().
 */
function jssotheme_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query) {
  if ($view->id() == 'jsso_knowledge_hub') {
    $request_query = \Drupal::request()->query->all();

    if (!empty($request_query['custom_focus_area'])) {
      $focus_values = array_filter((array)$request_query['custom_focus_area']);
      if (!empty($focus_values)) {
        $join = \Drupal\views\Views::pluginManager('join')->createInstance('standard', [
          'table' => 'node__field_realated_focus_area',
          'field' => 'entity_id',
          'left_table' => 'node_field_data',
          'left_field' => 'nid',
        ]);
        $query->addRelationship('node__field_realated_focus_area', $join, 'node_field_data');
        $query->addWhere('1', 'node__field_realated_focus_area.field_realated_focus_area_target_id', $focus_values, 'IN');
      }
    }

    if (!empty($request_query['custom_initiatives'])) {
      $initiative_values = array_filter((array)$request_query['custom_initiatives']);
      if (!empty($initiative_values)) {
        $join = \Drupal\views\Views::pluginManager('join')->createInstance('standard', [
          'table' => 'node__field_related_initiatives',
          'field' => 'entity_id',
          'left_table' => 'node_field_data',
          'left_field' => 'nid',
        ]);
        $query->addRelationship('node__field_related_initiatives', $join, 'node_field_data');
        $query->addWhere('1', 'node__field_related_initiatives.field_related_initiatives_target_id', $initiative_values, 'IN');
      }
    }
  }
}
