@use '../abstracts' as *;

.newsletter-subscribe-block {
    text-align: center;
    padding: 5rem 2rem;
    background-color: var(--clr-brand-jsso-primary);
    background-image: radial-gradient(circle at top right, rgba(255, 255, 255, 0.05), transparent),
        linear-gradient(135deg, var(--clr-brand-jsso-primary) 0%, var(--clr-brand-jsso-accents) 100%);
    background: url(../assets/images/subscribe-bg.svg)no-repeat top right / 80% var(--clr-brand-jsso-primary);
    border-radius: 40px;
    margin: 4rem 0;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 50, 70, 0.2);

    &::before {
        content: "";
        position: absolute;
        top: -50px;
        left: -50px;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 50%;
        z-index: 0;
    }

    h2 {
        font-family: var(--secondary-font);
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--clr-bg-300);
        margin-bottom: 1.25rem;
        font-weight: 700;
        position: relative;
        z-index: 1;
    }

    p {
        font-family: var(--body-font);
        font-size: 1.15rem;
        color: var(--clr-bg-100);
        margin-bottom: 3.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.7;
        position: relative;
        z-index: 1;
    }
}

.newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;

    .form-item {
        margin: 0;
        width: 100%;
        text-align: left;

        label {
            display: block;
            margin-bottom: 0.75rem;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(244, 244, 241, 0.85);
            padding-left: 1.5rem;
        }
    }

    .form-control,
    .newsletter-email-field {
        width: 100%;
        padding: 1.1rem 1.75rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        font-size: 1rem;
        background-color: rgba(255, 255, 255, 0.95);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);

        &:focus {
            outline: none;
            background-color: #fff;
            box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        &::placeholder {
            color: #777;
            font-weight: 400;
        }
    }

    .form-actions {
        display: flex;
        align-items: flex-end;
        width: 100%;
        margin: 0;
    }

    .newsletter-submit-button,
    .btn-primary {
        padding: 1.1rem 3rem;
        background-color: var(--clr-brand-jsso-beige);
        color: var(--clr-brand-jsso-primary);
        border: none;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        width: 100%;
        text-transform: none;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);

        &:hover {
            background-color: #fff;
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.15);
            color: #004a6b;
        }

        &:active {
            transform: translateY(0);
        }
    }

    @media (min-width: 992px) {
        flex-direction: row;
        align-items: flex-end;
        background: var(--clr-brand-jsso-accents);
        padding: 0.6rem;
        border-radius: 60px;
        //backdrop-filter: blur(10px);
        max-width: 700px;
        gap: 0.5rem;

        .form-item {
            flex: 1;

            label {
                display: none; // Minimalist approach like the reference
            }
        }

        .form-control,
        .newsletter-email-field {
            background-color: transparent;
            border: none;
            box-shadow: none;
            color: white;
            padding: 1rem 1.5rem;

            &:focus {
                background-color: transparent;
                box-shadow: none;
                transform: none;
            }

            &::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }
        }

        .form-actions {
            width: auto;
        }

        .newsletter-submit-button,
        .btn-primary {
            width: auto;
            padding: 1rem 2.5rem;
        }

        // Add separator lines between inputs if preferred
        .form-item:not(:last-child) {
            //border-right: 1px solid rgba(255, 255, 255, 0.2);
        }
    }
}