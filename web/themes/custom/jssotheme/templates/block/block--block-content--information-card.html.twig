{#
/**
 * @file
 * Theme override for the Information Card custom block.
 */
#}
{% set block_entity = content['#block_content'] %}
{% set has_image = block_entity ? not block_entity.field_image.isEmpty() : (content.field_image|render|striptags('<img><picture><source>')|trim is not empty) %}
{%
  set classes = [
    'block',
    'block-information-card',
    has_image ? 'has-image' : 'no-image',
  ]
%}
{% set icon_class = block_entity ? block_entity.field_icon.value : content.field_icon|render|striptags|trim %}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes.addClass('information-card-main-title') }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    <div class="information-card-wrapper">
      {% if has_image %}
        <div class="information-card-image">
          {{ content.field_image }}
        </div>
      {% endif %}

      <div class="information-card-content">
        <div class="information-card-header">
          {% if icon_class %}
            <div class="information-card-icon">
              <i class="{{ icon_class }}"></i>
            </div>
          {% endif %}
          
          {% if content.field_title|render|striptags|trim %}
            <div class="information-card-title">{{ content.field_title }}</div>
          {% endif %}
        </div>
        
        {% if content.field_subtitle|render|striptags|trim %}
          <div class="information-card-subtitle">{{ content.field_subtitle }}</div>
        {% endif %}
        
        {% if content.field_description|render|striptags|trim %}
          <div class="information-card-description">{{ content.field_description }}</div>
        {% endif %}
        
        {% if not block_entity.field_link.isEmpty() %}
        <div class="information-card-link">
          <a href="{{ block_entity.field_link[0].getUrl().toString() }}">
            {{ block_entity.field_link.title }} <i class="fa-solid fa-arrow-right" style="margin-left: 10px;"></i>
          </a>
        </div>
      {% endif %}
      </div>
    </div>
  {% endblock %}
</div>
